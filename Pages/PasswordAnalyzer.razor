@page "/password"
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Security.Cryptography

<PageTitle>Password Analyzer · MyToolKit</PageTitle>

<TerminalWindow Title="~/mytoolkit/password-analyzer">
    <h1>Password Analyzer</h1>

    <label class="prompt">
        <span class="prompt-symbol">❯</span>
        <input type="text"
               class="@(showPassword ? "" : "masked")"
               @bind="password"
               @bind:event="oninput"
               @bind:after="Analyze"
               placeholder="type a password..."
               autocomplete="off"
               spellcheck="false"
               data-lpignore="true"
               data-1p-ignore
               data-bwignore />
        <button type="button" class="toggle" @onclick="ToggleVisibility">
            @(showPassword ? "hide" : "show")
        </button>
    </label>

    <p class="output">length: <span class="value">@password.Length</span> chars</p>
    <ul class="checks">
        <li class="@(hasLower ? "ok" : "")">@(hasLower ? "[✓]" : "[ ]") lowercase (a-z)</li>
        <li class="@(hasUpper ? "ok" : "")">@(hasUpper ? "[✓]" : "[ ]") uppercase (A-Z)</li>
        <li class="@(hasDigit ? "ok" : "")">@(hasDigit ? "[✓]" : "[ ]") numbers (0-9)</li>
        <li class="@(hasSymbol ? "ok" : "")">@(hasSymbol ? "[✓]" : "[ ]") symbols (!@@#...)</li>
    </ul>

    <div class="meter">
        <div class="meter-fill @strength.ToString().ToLower()" style="width: @(MeterPercent)%"></div>
    </div>

    <p class="output">
        entropy: <span class="value">@entropy.ToString("0.0")</span> bits ·
        strength: <span class="strength @strength.ToString().ToLower()">@StrengthLabel</span>
    </p>

    @if (isCommon)
    {
        <p class="alert">⚠ this password appears in a list of leaked passwords. attackers try these first.</p>
    }

</TerminalWindow>

<TerminalWindow Title="~/mytoolkit/password-generator">
    <h1>Password Generator</h1>

    <label class="option">
        length: <span class="value">@genLength</span>
        <input type="range" min="8" max="64" @bind="genLength" @bind:event="oninput" />
    </label>

    <div class="options">
        <label class="option"><input type="checkbox" @bind="genLower" /> a-z</label>
        <label class="option"><input type="checkbox" @bind="genUpper" /> A-Z</label>
        <label class="option"><input type="checkbox" @bind="genDigits" /> 0-9</label>
        <label class="option"><input type="checkbox" @bind="genSymbols" /> symbols</label>
    </div>

    <button type="button" class="btn" @onclick="Generate">generate</button>

    @if (!string.IsNullOrEmpty(generated))
    {
        <div class="prompt generated">
            <span class="prompt-symbol">❯</span>
            <code>@generated</code>
            <button type="button" class="toggle" @onclick="CopyGenerated">
                @(copied ? "copied ✓" : "copy")
            </button>
            <button type="button" class="toggle" @onclick="UseGenerated">analyze</button>
        </div>
    }
</TerminalWindow>

@code {
    private string password = string.Empty;
    private bool showPassword = false;

    private bool hasLower;
    private bool hasUpper;
    private bool hasDigit;
    private bool hasSymbol;
    private double entropy;
    private StrengthLevel strength = StrengthLevel.None;
    private enum StrengthLevel { None, VeryWeak, Weak, Fair, Strong, VeryStrong }
    private HashSet<string> commonPasswords = new(StringComparer.OrdinalIgnoreCase);
    private bool isCommon;
    private int genLength = 16;
    private bool genLower = true;
    private bool genUpper = true;
    private bool genDigits = true;
    private bool genSymbols = true;
    private string generated = string.Empty;
    private bool copied;

    private const string LowerChars = "abcdefghijklmnopqrstuvwxyz";
    private const string UpperChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    private const string DigitChars = "0123456789";
    private const string SymbolChars = "!@#$%^&*()-_=+[]{};:,.<>?/";


    protected override async Task OnInitializedAsync()
    {
        var text = await Http.GetStringAsync("data/common_passwords.txt");
        var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        commonPasswords = new HashSet<string>(lines, StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleVisibility()
    {
        showPassword = !showPassword;
    }

    private void Analyze()
    {
        hasLower = false;
        hasUpper = false;
        hasDigit = false;
        hasSymbol = false;

        foreach (char c in password)
        {
            if (char.IsLower(c))
                hasLower = true;
            else if (char.IsUpper(c))
                hasUpper = true;
            else if (char.IsDigit(c))
                hasDigit = true;
            else
                hasSymbol = true;
        }

        int poolSize = 0;
        if (hasLower) poolSize += 26;
        if (hasUpper) poolSize += 26;
        if (hasDigit) poolSize += 10;
        if (hasSymbol) poolSize += 33;

        entropy = password.Length == 0 ? 0 : password.Length * Math.Log2(poolSize);

        strength = entropy switch
        {
            <= 0 => StrengthLevel.None,
            < 28 => StrengthLevel.VeryWeak,
            < 36 => StrengthLevel.Weak,
            < 60 => StrengthLevel.Fair,
            < 80 => StrengthLevel.Strong,
            _ => StrengthLevel.VeryStrong
        };

        isCommon = commonPasswords.Contains(password);

        if (isCommon)
        {
            strength = StrengthLevel.VeryWeak;
        }

    }

    private int MeterPercent => (int)Math.Min(entropy, 100);

    private string StrengthLabel => strength switch
    {
        StrengthLevel.VeryWeak => "very weak",
        StrengthLevel.Weak => "weak",
        StrengthLevel.Fair => "fair",
        StrengthLevel.Strong => "strong",
        StrengthLevel.VeryStrong => "very strong",
        _ => "—"
    };

    private void Generate()
    {
        var selectedSets = new List<string>();
        if (genLower) selectedSets.Add(LowerChars);
        if (genUpper) selectedSets.Add(UpperChars);
        if (genDigits) selectedSets.Add(DigitChars);
        if (genSymbols) selectedSets.Add(SymbolChars);

        if (selectedSets.Count == 0)
        {
            generated = string.Empty;
            return;
        }

        string pool = string.Concat(selectedSets);
        char[] result = new char[genLength];

        // 1. Un carácter garantizado de cada tipo marcado
        for (int i = 0; i < selectedSets.Count; i++)
        {
            string set = selectedSets[i];
            result[i] = set[RandomNumberGenerator.GetInt32(set.Length)];
        }

        // 2. El resto, del pool completo
        for (int i = selectedSets.Count; i < genLength; i++)
        {
            result[i] = pool[RandomNumberGenerator.GetInt32(pool.Length)];
        }

        // 3. Mezclar para que los garantizados no queden siempre al principio
        RandomNumberGenerator.Shuffle(result.AsSpan());

        generated = new string(result);
    }

    private void UseGenerated()
        {
            password = generated;
            Analyze();
        }

    private async Task CopyGenerated()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", generated);
            copied = true;
            StateHasChanged();

            await Task.Delay(2000);
            copied = false;
        }
        catch (JSException)
        {
            // El navegador bloqueó el acceso al portapapeles
        }
    }

}