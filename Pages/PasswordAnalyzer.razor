@page "/password"

<PageTitle>Password Analyzer · MyToolKit</PageTitle>

<TerminalWindow Title="~/mytoolkit/password-analyzer">
    <h1>Password Analyzer</h1>

    <label class="prompt">
        <span class="prompt-symbol">❯</span>
        <input type="text"
               class="@(showPassword ? "" : "masked")"
               @bind="password"
               @bind:event="oninput"
               placeholder="type a password..."
               autocomplete="off"
               spellcheck="false"
               data-lpignore="true"
               data-1p-ignore
               data-bwignore />
        <button type="button" class="toggle" @onclick="ToggleVisibility">
            @(showPassword ? "hide" : "show")
        </button>
    </label>

    <p class="output">length: <span class="value">@password.Length</span> chars</p>
</TerminalWindow>

@code {
    private string password = string.Empty;
    private bool showPassword = false;

    private void ToggleVisibility()
    {
        showPassword = !showPassword;
    }
}