@page "/password"
@inject PasswordService Passwords
@inject IJSRuntime JS

<PageTitle>Password Analyzer · MyToolKit</PageTitle>

<TerminalWindow Title="~/mytoolkit/password-analyzer">
    <h1>Password Analyzer</h1>

    <label class="prompt">
        <span class="prompt-symbol">❯</span>
        <input type="text"
               class="@(_showPassword ? "" : "masked")"
               @bind="_password"
               @bind:event="oninput"
               @bind:after="Analyze"
               placeholder="type a password..."
               autocomplete="off"
               spellcheck="false"
               data-lpignore="true"
               data-1p-ignore
               data-bwignore />
        <button type="button" class="toggle" @onclick="ToggleVisibility">
            @(_showPassword ? "hide" : "show")
        </button>
    </label>

    <p class="output">length: <span class="value">@_analysis.Length</span> chars</p>

    <ul class="checks">
        <li class="@(_analysis.HasLower ? "ok" : "")">@(_analysis.HasLower ? "[✓]" : "[ ]") lowercase (a-z)</li>
        <li class="@(_analysis.HasUpper ? "ok" : "")">@(_analysis.HasUpper ? "[✓]" : "[ ]") uppercase (A-Z)</li>
        <li class="@(_analysis.HasDigit ? "ok" : "")">@(_analysis.HasDigit ? "[✓]" : "[ ]") numbers (0-9)</li>
        <li class="@(_analysis.HasSymbol ? "ok" : "")">@(_analysis.HasSymbol ? "[✓]" : "[ ]") symbols (!@@#...)</li>
    </ul>

    <div class="meter">
        <div class="meter-fill @StrengthCss" style="@MeterStyle"></div>
    </div>

    <p class="output">
        entropy: <span class="value">@_analysis.Entropy.ToString("0.0")</span> bits ·
        strength: <span class="strength @StrengthCss">@StrengthLabel</span>
    </p>

    @if (_analysis.IsCommon)
    {
        <p class="alert">⚠ this password appears in a list of leaked passwords. attackers try these first.</p>
    }

    @if (_listFailed)
    {
        <p class="alert">⚠ could not load the leaked passwords list. that check is disabled.</p>
    }
</TerminalWindow>

<TerminalWindow Title="~/mytoolkit/password-generator">
    <h1>Password Generator</h1>

    <label class="option">
        length: <span class="value">@_genLength</span>
        <input type="range" min="8" max="64" @bind="_genLength" @bind:event="oninput" />
    </label>

    <div class="options">
        <label class="option"><input type="checkbox" @bind="_genLower" /> a-z</label>
        <label class="option"><input type="checkbox" @bind="_genUpper" /> A-Z</label>
        <label class="option"><input type="checkbox" @bind="_genDigits" /> 0-9</label>
        <label class="option"><input type="checkbox" @bind="_genSymbols" /> symbols</label>
    </div>

    <button type="button" class="btn" @onclick="Generate">generate</button>

    @if (!string.IsNullOrEmpty(_generated))
    {
        <div class="prompt generated">
            <span class="prompt-symbol">❯</span>
            <code>@_generated</code>
            <button type="button" class="toggle" @onclick="CopyGenerated">
                @(_copied ? "copied ✓" : "copy")
            </button>
            <button type="button" class="toggle" @onclick="UseGenerated">analyze</button>
        </div>
    }
</TerminalWindow>

@code {
    private string _password = string.Empty;
    private bool _showPassword;
    private PasswordAnalysis _analysis = PasswordAnalysis.Empty;
    private bool _listFailed;

    private int _genLength = 16;
    private bool _genLower = true;
    private bool _genUpper = true;
    private bool _genDigits = true;
    private bool _genSymbols = true;
    private string _generated = string.Empty;
    private bool _copied;

    protected override async Task OnInitializedAsync()
    {
        _listFailed = !await Passwords.LoadCommonPasswordsAsync();
    }

    private void Analyze() => _analysis = Passwords.Analyze(_password);

    private void ToggleVisibility() => _showPassword = !_showPassword;

    private void Generate() =>
        _generated = Passwords.Generate(_genLength, _genLower, _genUpper, _genDigits, _genSymbols);

    private void UseGenerated()
    {
        _password = _generated;
        Analyze();
    }

    private async Task CopyGenerated()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generated);
            _copied = true;
            StateHasChanged();

            await Task.Delay(2000);
            _copied = false;
        }
        catch (JSException)
        {
        }
    }

    private int MeterPercent => (int)Math.Min(_analysis.Entropy, 100);
    private string MeterStyle => $"width: {MeterPercent}%";

    private string StrengthCss => _analysis.Strength.ToString().ToLower();

    private string StrengthLabel => _analysis.Strength switch
    {
        StrengthLevel.VeryWeak => "very weak",
        StrengthLevel.Weak => "weak",
        StrengthLevel.Fair => "fair",
        StrengthLevel.Strong => "strong",
        StrengthLevel.VeryStrong => "very strong",
        _ => "—"
    };
}